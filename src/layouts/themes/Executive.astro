---
interface Props {
  person: any
  experience: Array<{ data: any; body: string }>
  projects: Array<{ data: any; body: string }>
  skills: Array<{ label: string; items: string[] }>
  education: Array<any>
  certifications: string[]
  hobbies: string
}
const { person, experience, projects, skills, education, certifications, hobbies } = Astro.props

function parseBullets(body: string): string[] {
  return body.split('\n').map(l => l.replace(/^-\s+/, '').trim()).filter(Boolean)
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{person.name} — Resume</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap" rel="stylesheet" />
    <style is:inline>
      :root {
        --white:      #ffffff;
        --off-white:  #f9f9f9;
        --ink:        #0c0c0c;
        --ink-mid:    #3a3a3a;
        --ink-light:  #717171;
        --ink-faint:  #aaaaaa;
        --navy:       #1a2744;
        --navy-mid:   #2c3e6b;
        --navy-light: #e8ecf5;
        --rule:       #e8e8e8;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; }

      body {
        background: var(--white);
        color: var(--ink-mid);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 400;
        min-height: 100vh;
        padding-bottom: 100px;
      }

      /* Download button */
      .download-btn {
        position: fixed;
        bottom: 28px;
        right: 28px;
        background: var(--navy);
        color: var(--white);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        padding: 11px 22px;
        border-radius: 4px;
        z-index: 100;
        transition: background 0.2s;
        letter-spacing: 0.3px;
      }
      .download-btn:hover { background: var(--navy-mid); }

      .page {
        max-width: 880px;
        margin: 0 auto;
        padding: 0 48px;
      }

      /* ── Top accent bar ──────────────────────── */
      .accent-bar {
        height: 4px;
        background: var(--navy);
        margin-bottom: 52px;
      }

      /* ── Header ──────────────────────────────── */
      .header {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 32px;
        align-items: start;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 48px;
      }

      .header-name {
        font-size: clamp(40px, 5.5vw, 60px);
        font-weight: 800;
        color: var(--ink);
        line-height: 1;
        letter-spacing: -1.5px;
        margin-bottom: 10px;
        opacity: 0;
        transform: translateY(20px);
        animation: rise 0.6s cubic-bezier(0.22,1,0.36,1) 0.1s forwards;
      }

      .header-title {
        font-size: 15px;
        font-weight: 500;
        color: var(--navy);
        margin-bottom: 20px;
        letter-spacing: 0.1px;
        opacity: 0;
        animation: fadein 0.5s ease 0.5s forwards;
      }

      .header-summary {
        font-size: 15px;
        font-weight: 400;
        color: var(--ink-light);
        line-height: 1.72;
        max-width: 500px;
        opacity: 0;
        animation: fadein 0.5s ease 0.7s forwards;
      }

      .header-contact {
        text-align: right;
        opacity: 0;
        animation: fadein 0.5s ease 0.6s forwards;
      }
      .contact-item {
        font-size: 13px;
        font-weight: 400;
        color: var(--ink-light);
        line-height: 2.1;
        letter-spacing: 0.1px;
      }
      .contact-item a {
        color: var(--navy);
        text-decoration: none;
        font-weight: 500;
      }
      .contact-item a:hover { text-decoration: underline; }

      @keyframes rise { to { opacity: 1; transform: none; } }
      @keyframes fadein { to { opacity: 1; } }

      /* ── Section ─────────────────────────────── */
      .section { margin-bottom: 48px; }

      .section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
      }
      .section-heading-bar {
        width: 3px;
        height: 18px;
        background: var(--navy);
        border-radius: 2px;
        flex-shrink: 0;
      }
      .section-heading-text {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--navy);
      }
      .section-heading-line {
        flex: 1;
        height: 1px;
        background: var(--rule);
      }

      /* ── Experience ──────────────────────────── */
      .experience-entry {
        padding: 22px 0;
        border-bottom: 1px solid var(--rule);
      }
      .experience-entry:first-child { border-top: 1px solid var(--rule); }

      .entry-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 16px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }
      .entry-title {
        font-size: 17px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 3px;
        letter-spacing: -0.3px;
      }
      .entry-company {
        font-size: 13px;
        font-weight: 500;
        color: var(--navy);
        letter-spacing: 0.1px;
      }
      .entry-dates {
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-faint);
        white-space: nowrap;
        background: var(--off-white);
        padding: 4px 12px;
        border-radius: 20px;
        flex-shrink: 0;
        letter-spacing: 0.2px;
      }

      .entry-bullets { list-style: none; }
      .entry-bullets li {
        font-size: 14px;
        font-weight: 400;
        color: var(--ink-mid);
        line-height: 1.75;
        padding-left: 16px;
        position: relative;
        margin-bottom: 5px;
      }
      .entry-bullets li::before {
        content: '';
        position: absolute;
        left: 4px;
        top: 8px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--navy);
        opacity: 0.4;
      }

      /* ── Projects ────────────────────────────── */
      .projects-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .project-entry {
        background: var(--off-white);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 18px 20px;
        transition: border-color 0.15s;
      }
      .project-entry:hover { border-color: var(--navy-light); }

      .project-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 4px;
        letter-spacing: -0.2px;
      }
      .project-client {
        font-size: 11px;
        font-weight: 600;
        color: var(--navy);
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        text-transform: uppercase;
      }
      .project-body {
        font-size: 13px;
        font-weight: 400;
        color: var(--ink-light);
        line-height: 1.7;
        margin-bottom: 10px;
      }
      .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }
      .tech-pill {
        font-size: 11px;
        font-weight: 600;
        color: var(--navy);
        background: var(--navy-light);
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.2px;
      }

      /* ── Skills ──────────────────────────────── */
      .skills-block {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .skill-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 8px 24px;
        padding: 14px 0;
        border-bottom: 1px solid var(--rule);
        align-items: center;
      }
      .skill-row:first-child { border-top: 1px solid var(--rule); }
      .skill-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--navy);
        letter-spacing: 1.5px;
        text-transform: uppercase;
      }
      .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .skill-pill {
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-mid);
        background: var(--off-white);
        border: 1px solid var(--rule);
        padding: 3px 12px;
        border-radius: 20px;
        letter-spacing: 0.1px;
      }

      /* ── Education ───────────────────────────── */
      .edu-entry {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid var(--rule);
      }
      .edu-entry:first-child { border-top: 1px solid var(--rule); }
      .edu-degree {
        font-size: 16px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.2px;
        margin-bottom: 3px;
      }
      .edu-institution {
        font-size: 13px;
        font-weight: 400;
        color: var(--ink-light);
      }
      .edu-year {
        font-size: 12px;
        font-weight: 600;
        color: var(--white);
        background: var(--navy);
        padding: 4px 12px;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
      }

      /* ── Certifications ──────────────────────── */
      .cert-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      .cert-entry {
        font-size: 13px;
        font-weight: 400;
        color: var(--ink-mid);
        background: var(--off-white);
        border: 1px solid var(--rule);
        border-radius: 4px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        line-height: 1.4;
      }
      .cert-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--navy);
        flex-shrink: 0;
        opacity: 0.5;
      }

      /* ── Hobbies ─────────────────────────────── */
      .hobbies-text {
        font-size: 15px;
        font-weight: 400;
        color: var(--ink-light);
        line-height: 1.78;
        max-width: 600px;
      }

      /* ── Reveal ──────────────────────────────── */
      [data-reveal] {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1), transform 0.55s cubic-bezier(0.22,1,0.36,1);
      }
      [data-reveal].visible { opacity: 1; transform: none; }

      /* ── Print ───────────────────────────────── */
      @media print {
        body { background: var(--white); padding: 0 14mm; }
        html { background: var(--white); }
        .download-btn { display: none !important; }
        .experience-entry, .project-entry, .edu-entry, .cert-entry { break-inside: avoid; }
        .section-heading { break-after: avoid; }
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        .header-name { opacity: 1 !important; animation: none !important; transform: none !important; }
        .header-title, .header-summary, .header-contact { opacity: 1 !important; animation: none !important; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        @page { size: A4; margin: 10mm 0; }
      }

      @media (max-width: 640px) {
        .header { grid-template-columns: 1fr; }
        .projects-grid, .cert-grid { grid-template-columns: 1fr; }
        .skill-row { grid-template-columns: 1fr; gap: 6px; }
        .page { padding: 0 20px; }
      }
    </style>
  </head>
  <body>
    <a href="./resume.pdf" class="download-btn no-print" download>↓ Download PDF</a>

    <!-- Top accent bar -->
    <div class="accent-bar"></div>

    <main class="page">

      <!-- Header -->
      <header class="header">
        <div>
          <h1 class="header-name">{person.name}</h1>
          <p class="header-title">{person.title}</p>
          <p class="header-summary">{person.summary}</p>
        </div>
        <div class="header-contact">
          {[
            { label: person.email, href: `mailto:${person.email}` },
            { label: person.phone },
            { label: person.location },
            { label: 'LinkedIn ↗', href: person.linkedinUrl },
            { label: 'GitHub ↗',   href: person.githubUrl },
          ].map(item => (
            <div class="contact-item">
              {item.href
                ? <a href={item.href} target="_blank" rel="noopener">{item.label}</a>
                : item.label}
            </div>
          ))}
        </div>
      </header>

      <!-- Experience -->
      <section class="section" aria-label="Experience">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Experience</span>
          <span class="section-heading-line"></span>
        </div>
        {experience.map((job, i) => (
          <article class="experience-entry" data-reveal style={`transition-delay:${i*50}ms`}>
            <div class="entry-top">
              <div>
                <div class="entry-title">{job.data.title}</div>
                <div class="entry-company">{job.data.company}{job.data.location ? ` · ${job.data.location}` : ''}</div>
              </div>
              <span class="entry-dates">{job.data.startDate} – {job.data.endDate}</span>
            </div>
            <ul class="entry-bullets">
              {parseBullets(job.body).map(b => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <!-- Projects -->
      <section class="section" aria-label="Projects">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Projects</span>
          <span class="section-heading-line"></span>
        </div>
        <div class="projects-grid">
          {projects.map((p, i) => (
            <article class="project-entry" data-reveal style={`transition-delay:${i*40}ms`}>
              <div class="project-name">{p.data.name}</div>
              {p.data.client && <div class="project-client">{p.data.client}</div>}
              <p class="project-body">{p.body.trim()}</p>
              <div class="project-tech">
                {p.data.tech.map((t: string) => <span class="tech-pill">{t}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="section" aria-label="Skills">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Skills</span>
          <span class="section-heading-line"></span>
        </div>
        <div class="skills-block" data-reveal>
          {skills.map(group => (
            <div class="skill-row">
              <span class="skill-label">{group.label}</span>
              <div class="skill-pills">
                {group.items.map((item: string) => <span class="skill-pill">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="section" aria-label="Education">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Education</span>
          <span class="section-heading-line"></span>
        </div>
        <div data-reveal>
          {education.map(edu => (
            <div class="edu-entry">
              <div>
                <div class="edu-degree">{edu.degree}</div>
                <div class="edu-institution">{edu.institution}</div>
              </div>
              {edu.year && <span class="edu-year">{edu.year}</span>}
            </div>
          ))}
        </div>
      </section>

      <!-- Certifications -->
      <section class="section" aria-label="Certifications">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Certifications</span>
          <span class="section-heading-line"></span>
        </div>
        <div class="cert-grid" data-reveal>
          {certifications.map(cert => (
            <div class="cert-entry">
              <span class="cert-dot"></span>
              <span>{cert}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Interests -->
      <section class="section" aria-label="Interests">
        <div class="section-heading">
          <span class="section-heading-bar"></span>
          <span class="section-heading-text">Interests</span>
          <span class="section-heading-line"></span>
        </div>
        <p class="hobbies-text" data-reveal>{hobbies}</p>
      </section>

    </main>

    <script>
      const obs = new IntersectionObserver(
        es => es.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target) } }),
        { threshold: 0.06 }
      )
      document.querySelectorAll('[data-reveal]').forEach(el => obs.observe(el))
    </script>
  </body>
</html>
