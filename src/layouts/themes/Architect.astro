---
interface Props {
  person: any
  experience: Array<{ data: any; body: string }>
  projects: Array<{ data: any; body: string }>
  skills: Array<{ label: string; items: string[] }>
  education: Array<any>
  certifications: string[]
  hobbies: string
}
const { person, experience, projects, skills, education, certifications, hobbies } = Astro.props
import { SERVICES, CLIENTS, PROCESS, ENGAGEMENT, RECENT_WORK, INDUSTRIES } from '../../config'
const featuredProjects = projects.filter(p => p.data.featured !== false)
const mailSubject = encodeURIComponent('Project enquiry')
const mailBody = encodeURIComponent('Hi Sandeep,\n\nA few lines about what we are building and what is in the way:\n\n')
const contactHref = `mailto:${person.email}?subject=${mailSubject}&body=${mailBody}`
const ogImageUrl = new URL(person.ogImage ?? 'og.png', person.siteUrl).href
const personId = person.siteUrl + '#person'
const portraitUrl = `${import.meta.env.BASE_URL}/portrait.webp`.replace('//', '/')
const portraitAbs = new URL('portrait.webp', person.siteUrl).href
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': person.siteUrl,
      url: person.siteUrl,
      name: person.seoTitle,
      description: person.seoDescription,
      inLanguage: 'en',
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': personId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: 1200, height: 630 },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: person.name,
      givenName: person.name.split(' ')[0],
      familyName: person.name.split(' ').slice(1).join(' '),
      jobTitle: 'Salesforce & Heroku Architect',
      description: person.summary,
      image: portraitAbs,
      email: `mailto:${person.email}`,
      telephone: person.phone,
      url: person.siteUrl,
      sameAs: [person.linkedinUrl, person.githubUrl, person.companyUrl],
      address: { '@type': 'PostalAddress', addressLocality: 'Jaipur', addressRegion: 'Rajasthan', addressCountry: 'IN' },
      worksFor: { '@type': 'Organization', name: person.company ?? 'CloudAlgo', url: person.companyUrl },
      alumniOf: [...new Set(education.map(e => e.institution))].map(name => ({ '@type': 'CollegeOrUniversity', name })),
      hasCredential: certifications.map(name => ({ '@type': 'EducationalOccupationalCredential', name, credentialCategory: 'certification' })),
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Salesforce Architect',
        occupationLocation: { '@type': 'Country', name: 'Remote' },
        skills: skills.flatMap(g => g.items).join(', '),
      },
      knowsAbout: ['Salesforce', 'Heroku', 'MuleSoft', 'MuleSoft RPA', 'Apache Airflow', 'AWS', 'AWS Lambda', 'AWS Fargate', 'Amazon Cognito', 'Apex', 'Lightning Web Components', 'Node.js', 'React', 'React Native', 'Next.js', 'System integration', 'Non-profit Salesforce implementation', 'Healthcare Salesforce implementation'],
      makesOffer: SERVICES.map(sv => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.title, description: sv.outcome, provider: { '@type': 'Organization', name: 'CloudAlgo', url: person.companyUrl } } })),
    },
  ],
})

function parseBullets(body: string): string[] {
  return body.split('\n').map(l => l.replace(/^-\s+/, '').trim()).filter(Boolean)
}

/* Year range for the timeline rail, e.g. "2022 — Present" */
function yearsOf(job: any): string {
  const y = (s: string) => s.split(' ').pop()
  const a = y(job.startDate)
  const b = job.endDate === 'Present' ? 'Present' : y(job.endDate)
  return a === b ? a! : `${a} — ${b}`
}

const CAPABILITIES = [
  { label: 'Salesforce',   blurb: 'Sales, Service and Experience Cloud builds, Apex, Lightning Web Components, managed packages' },
  { label: 'Heroku',       blurb: 'Node.js services and microservices that run beside your org and talk to legacy systems' },
  { label: 'Web apps',     blurb: 'React and Next.js portals, intranets and customer-facing apps' },
  { label: 'Mobile',       blurb: 'React Native and native iOS, from first build to App Store release' },
  { label: 'Integrations', blurb: 'REST and SOAP, Office 365, Metadata API tooling, AI services' },
  { label: 'Data',         blurb: 'PostgreSQL, MongoDB, Redis, reporting and analytics pipelines' },
]

function clientOf(c?: string): [string, string?] {
  if (!c) return ['Project']
  const m = c.match(/^(.*?)\s*\(via (.*?)\)$/)
  return m ? [m[1], m[2]] : [c]
}

const sfCerts = certifications.filter(c => c.toLowerCase().includes('salesforce'))
const otherCerts = certifications.filter(c => !c.toLowerCase().includes('salesforce'))

const firstYear = Math.min(...experience.map(j => parseInt(j.data.startDate.split(' ').pop() ?? '0')))
const years = new Date().getFullYear() - firstYear

const NAV = [
  { id: 'about', label: 'About' },
  { id: 'services', label: 'What I do' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'certifications', label: 'Certifications' },
  { id: 'education', label: 'Education' },
  { id: 'contact', label: 'Work with me' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{person.seoTitle ?? `${person.name} — ${person.title}`}</title>
    <meta name="description" content={person.seoDescription ?? person.summary} />
    <meta name="author" content={person.name} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#14171C" />
    <link rel="canonical" href={person.siteUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}/sitemap.xml`.replace('//', '/')} />
    <link rel="alternate" type="application/pdf" href={`${import.meta.env.BASE_URL}/resume.pdf`.replace('//', '/')} title="Sandeep Kumar CV (PDF)" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={`${person.name} — ${person.company ?? 'CloudAlgo'}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={person.seoTitle ?? person.name} />
    <meta property="og:description" content={person.seoDescription ?? person.summary} />
    <meta property="og:url" content={person.siteUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, Salesforce & Heroku Architect, co-founder of CloudAlgo`} />
    <meta property="profile:first_name" content={person.name.split(' ')[0]} />
    <meta property="profile:last_name" content={person.name.split(' ').slice(1).join(' ')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={person.seoTitle ?? person.name} />
    <meta name="twitter:description" content={person.seoDescription ?? person.summary} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={ldJson} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
    <style is:inline>
      :root {
        --bg:      #F5F6F8;
        --ink:     #14171C;
        --ink-2:   #464C56;
        --ink-3:   #7A828E;
        --rule:    #E1E4E9;
        --card:    #FFFFFF;
        --accent:  #0B5CAD;
        --accent-soft: #E8F0FA;
        --ok:      #1F8A4C;
        --display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
        --body:    'Instrument Sans', system-ui, -apple-system, sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body { background: var(--bg); color: var(--ink-2); font-family: var(--body); font-size: 15.5px; line-height: 1.6; }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
      ::selection { background: var(--accent-soft); }

      /* ── Frame ─────────────────────────────────── */
      .page { max-width: 1120px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 330px 1fr; grid-template-areas: 'id head' 'id content'; column-gap: 96px; row-gap: 0; align-items: start; }
      .masthead { grid-area: head; display: flex; align-items: center; gap: 28px; padding: 56px 0 40px; }
      .masthead-text { min-width: 0; }
      .masthead .id-name { font-size: 50px; }
      .masthead .id-title { font-size: 18px; margin-top: 10px; }
      .masthead .id-status { margin-top: 14px; }

      /* ── Identity column (sticky) ───────────────── */
      .id { grid-area: id; position: sticky; top: 0; height: 100vh; padding: 64px 0 36px; display: flex; flex-direction: column; overflow-y: auto; scrollbar-width: none; }
      .id::-webkit-scrollbar { display: none; }
      /* Portrait: grayscale at rest, colour on hover; availability dot sits on the rim like the timeline's "now" marker */
      .id-photo { position: relative; width: 132px; height: 132px; border-radius: 50%; flex: none; }
      .id-photo img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 0.45s ease, transform 0.45s ease; box-shadow: 0 0 0 1px var(--rule); }
      .id-photo::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1.5px solid var(--rule); transition: border-color 0.45s ease, transform 0.45s ease; }
      .id-photo::after { content: ''; position: absolute; right: 8px; bottom: 8px; width: 16px; height: 16px; border-radius: 50%; background: var(--ok); border: 2.5px solid var(--bg); }
      .id-photo:hover img, .id-photo:focus-within img { filter: none; transform: scale(1.03); }
      .id-photo:hover::before { border-color: var(--accent); transform: scale(1.04); }
      @media (hover: none) { .id-photo img { filter: none; } }
      @media (prefers-reduced-motion: reduce) { .id-photo img, .id-photo::before { transition: none; transform: none !important; } }
      .id-name { font-family: var(--display); font-variation-settings: 'opsz' 48, 'wdth' 94; font-weight: 700; font-size: 40px; line-height: 1; letter-spacing: -0.025em; color: var(--ink); }
      .id-title { margin-top: 12px; font-size: 17px; font-weight: 600; color: var(--ink); line-height: 1.4; }
      .id-status { display: inline-flex; align-items: center; gap: 8px; margin-top: 0; font-size: 13px; font-weight: 500; color: var(--ink-2); }
      .id-status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px #DDF1E4; }
      .id-pitch { margin-top: 0; font-size: 15.5px; line-height: 1.6; color: var(--ink-2); max-width: 300px; }

      .id-nav { margin-top: 30px; list-style: none; }
      .id-nav a { display: flex; align-items: center; gap: 12px; padding: 4.5px 0; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); transition: color 0.2s; }
      .id-nav a::before { content: ''; width: 28px; height: 1px; background: var(--ink-3); transition: width 0.25s, background 0.2s; }
      .id-nav a:hover, .id-nav a.active { color: var(--ink); }
      .id-nav a:hover::before, .id-nav a.active::before { width: 56px; background: var(--ink); }

      .id-foot { margin-top: auto; padding-top: 18px; }
      .id-contact { list-style: none; font-size: 14px; line-height: 1.8; color: var(--ink-2); }
      .id-contact a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
      .id-contact .muted { color: var(--ink-3); }
      .download-btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; padding: 10px 18px; background: var(--ink); color: #fff; font-size: 13.5px; font-weight: 600; border-radius: 6px; transition: background 0.2s, transform 0.2s; }
      .download-btn:hover { background: var(--accent); transform: translateY(-1px); }
      .download-btn svg { width: 15px; height: 15px; }

      /* ── Content column ─────────────────────────── */
      .content { grid-area: content; padding: 0 0 96px; }
      .section { padding-bottom: 88px; scroll-margin-top: 0; }
      .section:last-child { padding-bottom: 0; }
      .section-h { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); padding-bottom: 12px; margin-bottom: 8px; border-bottom: 1px solid var(--rule); }

      .about p { font-size: 16.5px; line-height: 1.65; margin-top: 16px; }
      .about .facts { display: flex; gap: 40px; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--rule); }
      .fact b { display: block; font-family: var(--display); font-variation-settings: 'opsz' 48; font-size: 30px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums; }
      .fact span { display: block; margin-top: 6px; font-size: 12.5px; color: var(--ink-3); letter-spacing: 0.02em; }

      /* Entry: date rail on the left, substance on the right */
      .entry { position: relative; display: grid; grid-template-columns: 132px 1fr; gap: 24px; padding: 22px 20px; margin: 0 -20px; border-radius: 8px; transition: background 0.25s, box-shadow 0.25s; }
      .entry:hover { background: var(--card); box-shadow: 0 1px 2px rgba(20,23,28,0.04), 0 12px 32px -12px rgba(20,23,28,0.14); }
      .entry-when { padding-right: 8px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); padding-top: 4px; font-variant-numeric: tabular-nums; }
      .entry-when small { display: block; margin-top: 4px; font-size: 12px; font-weight: 400; letter-spacing: 0; text-transform: none; }
      .entry-title { font-size: 16.5px; font-weight: 700; color: var(--ink); line-height: 1.35; }
      .entry-sub { font-size: 14.5px; color: var(--ink-2); margin-top: 2px; }
      .entry-sub .loc { color: var(--ink-3); }
      .entry ul { list-style: none; margin-top: 12px; }
      .entry li { position: relative; padding-left: 18px; font-size: 14.5px; line-height: 1.55; margin-bottom: 6px; }
      .entry li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; height: 1.5px; background: var(--ink-3); }
      .entry p { margin-top: 8px; font-size: 14.5px; line-height: 1.55; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
      .tags span { font-size: 12px; font-weight: 600; color: var(--accent); background: var(--accent-soft); padding: 4px 10px; border-radius: 999px; }

      /* Timeline rail behind the date column */
      .timeline { position: relative; }
      .timeline::before { content: ''; position: absolute; left: 144px; top: 30px; bottom: 30px; width: 1px; background: var(--rule); }
      .timeline .entry::after { content: ''; position: absolute; left: 140px; top: 29px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--ink-3); transition: border-color 0.25s, background 0.25s; }
      .timeline .entry:hover::after { border-color: var(--accent); background: var(--accent); }
      .timeline .entry:first-child::after { border-color: var(--ok); background: var(--ok); }

      /* Skills */
      .skill-row { display: grid; grid-template-columns: 132px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
      .skill-row:last-child { border-bottom: 0; }
      .skill-row b { font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); padding-top: 5px; }
      .skill-row .tags { margin-top: 0; }
      .skill-row .tags span { color: var(--ink-2); background: var(--card); border: 1px solid var(--rule); }

      /* Certifications */
      .cert-group { margin-top: 18px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
      .certs { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin-top: 2px; }
      .cert { display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-bottom: 1px solid var(--rule); font-size: 14.5px; color: var(--ink); }
      .cert svg { flex: none; width: 16px; height: 16px; margin-top: 3px; color: var(--accent); }
      .cert.other { color: var(--ink-2); }
      .cert.other svg { color: var(--ink-3); }

      /* Education */
      .edu { display: grid; grid-template-columns: 132px 1fr; gap: 24px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
      .edu:last-of-type { border-bottom: 0; }
      .edu span { font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); padding-top: 3px; font-variant-numeric: tabular-nums; }
      .edu b { display: block; font-size: 16px; font-weight: 700; color: var(--ink); }
      .edu em { font-style: normal; font-size: 14.5px; color: var(--ink-2); }
      .interests { margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--rule); font-size: 14px; color: var(--ink-3); line-height: 1.6; }

      /* Clients strip (About) */
      .clients { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--rule); }
      .clients b { display: block; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
      .clients ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 0; font-family: var(--display); font-variation-settings: 'opsz' 24, 'wdth' 92; font-weight: 600; font-size: 15px; color: var(--ink); }
      .clients li + li::before { content: '·'; color: var(--rule); margin: 0 12px; font-weight: 400; }

      /* Industries */
      .industries { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 32px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--rule); }
      .industries b { display: block; font-size: 15px; font-weight: 700; color: var(--ink); }
      .industries p { margin-top: 3px; font-size: 14px; line-height: 1.5; color: var(--ink-2); }
      .industries-h { grid-column: 1 / -1; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-bottom: -4px; }

      /* Services (what I do) */
      .services { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 18px; }
      .service { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 22px 22px 20px; transition: box-shadow 0.25s, border-color 0.25s, transform 0.25s; }
      .service:hover { border-color: transparent; box-shadow: 0 1px 2px rgba(20,23,28,0.04), 0 14px 36px -14px rgba(20,23,28,0.18); transform: translateY(-2px); }
      .service h3 { font-family: var(--display); font-variation-settings: 'opsz' 24, 'wdth' 94; font-size: 18px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); line-height: 1.3; }
      .service .problem { margin-top: 10px; font-size: 14px; line-height: 1.55; color: var(--ink-3); }
      .service .outcome { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--rule); font-size: 14.5px; line-height: 1.55; color: var(--ink-2); }
      .service .outcome::before { content: 'You get'; display: block; font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }

      /* Recent CloudAlgo work */
      .recent-h { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 44px; }
      .recent-h b { font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
      .recent-h a { font-size: 13.5px; font-weight: 600; color: var(--accent); white-space: nowrap; }
      .recent-h a:hover { text-decoration: underline; text-underline-offset: 3px; }
      .recent { list-style: none; margin-top: 10px; }
      .recent li { display: grid; grid-template-columns: 1fr 150px; gap: 20px; align-items: start; padding: 14px 0; border-bottom: 1px solid var(--rule); }
      .recent li:last-child { border-bottom: 0; }
      .recent .who { font-size: 12.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
      .recent .what { margin-top: 4px; font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
      .recent .stack { margin-top: 5px; font-size: 12.5px; font-weight: 600; color: var(--accent); }
      .recent .result { font-family: var(--display); font-variation-settings: 'opsz' 24, 'wdth' 94; font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: var(--ok); line-height: 1.25; text-align: right; }
      .recent .result small { display: block; margin-top: 3px; font-family: var(--body); font-size: 11.5px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }

      /* Process */
      .process { counter-reset: step; list-style: none; margin-top: 30px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
      .process li { counter-increment: step; position: relative; padding-top: 16px; border-top: 2px solid var(--ink); }
      .process li::before { content: counter(step, decimal-leading-zero); font-family: var(--display); font-variation-settings: 'opsz' 24; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
      .process b { display: block; margin-top: 6px; font-size: 15px; font-weight: 700; color: var(--ink); }
      .process p { margin-top: 6px; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }
      .process-h { margin-top: 44px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }

      /* Work with me (CTA) */
      .cta { background: var(--ink); color: #C9CED6; border-radius: 12px; padding: 40px 40px 36px; margin-top: 18px; }
      .cta h3 { font-family: var(--display); font-variation-settings: 'opsz' 48, 'wdth' 94; font-size: 30px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; color: #fff; max-width: 520px; }
      .cta > p { margin-top: 14px; font-size: 15.5px; line-height: 1.6; max-width: 560px; }
      .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
      .cta-actions a { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px; border-radius: 6px; font-size: 14px; font-weight: 600; transition: background 0.2s, color 0.2s, transform 0.2s; }
      .cta-actions a:hover { transform: translateY(-1px); }
      .cta-primary { background: #fff; color: var(--ink); }
      .cta-primary:hover { background: var(--accent-soft); }
      .cta-secondary { border: 1px solid #3A414B; color: #fff; }
      .cta-secondary:hover { border-color: #fff; }
      .engage { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 32px; margin-top: 34px; padding-top: 28px; border-top: 1px solid #2A2F37; }
      .engage b { display: block; font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8A919C; margin-bottom: 5px; }
      .engage p { font-size: 14px; line-height: 1.55; color: #C9CED6; }
      .id-pitch a { color: var(--accent); font-weight: 600; }
      .id-pitch a:hover { text-decoration: underline; text-underline-offset: 3px; }

      /* ── Motion ─────────────────────────────────── */
      :root { --ease-out: cubic-bezier(0.22, 1, 0.36, 1); }

      /* Load sequence: portrait settles, then name, title, status; sidebar follows */
      @keyframes rise { to { opacity: 1; transform: none; filter: none; } }
      .masthead .id-photo { opacity: 0; transform: scale(0.92); animation: rise 0.9s var(--ease-out) 0.05s forwards; }
      .masthead-text > *, .id > * { opacity: 0; transform: translateY(14px); animation: rise 0.7s var(--ease-out) forwards; }
      .masthead .id-name { filter: blur(6px); animation-duration: 0.85s; animation-delay: 0.18s; }
      .masthead .id-title { animation-delay: 0.3s; }
      .masthead .id-status { animation-delay: 0.4s; }
      .id > :nth-child(1) { animation-delay: 0.38s; }
      .id > :nth-child(2) { animation-delay: 0.48s; }
      .id > :nth-child(3) { animation-delay: 0.58s; }

      /* Section reveal, with children of grids arriving one after another */
      .section { opacity: 0; transform: translateY(12px); transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out); }
      .section.in { opacity: 1; transform: none; }
      .section [data-stagger] > * { opacity: 0; transform: translateY(10px); transition: opacity 0.55s var(--ease-out), transform 0.55s var(--ease-out); transition-delay: calc(var(--i, 0) * 55ms); }
      .section.in [data-stagger] > * { opacity: 1; transform: none; }

      /* Experience timeline draws itself as you read down; passed entries light up */
      .timeline::after { content: ''; position: absolute; left: 144px; top: 30px; bottom: 30px; width: 1px; background: var(--accent); transform-origin: top; transform: scaleY(var(--tl, 0)); }
      .timeline .entry.lit::after { border-color: var(--accent); background: var(--accent); }
      .timeline .entry:first-child::after { border-color: var(--ok); background: var(--ok); }

      /* Spotlight follows the cursor across the dark CTA card */
      .cta { position: relative; overflow: hidden; }
      .cta::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.09), transparent 62%); opacity: 0; transition: opacity 0.35s ease; }
      .cta:hover::before { opacity: 1; }
      .cta > * { position: relative; }

      /* Scroll rail: replaces the native scrollbar on desktop with a progress line and section ticks */
      .rail { display: none; }
      @media (min-width: 961px) and (pointer: fine) {
        html { scrollbar-width: none; }
        html::-webkit-scrollbar { display: none; }
        .rail { display: block; position: fixed; right: 22px; top: 36px; bottom: 36px; width: 14px; z-index: 50; opacity: 0; animation: rise 0.6s var(--ease-out) 0.8s forwards; }
        .rail-track { position: absolute; top: 0; bottom: 0; left: 6px; width: 1px; background: var(--rule); }
        .rail-fill { position: absolute; inset: 0; background: var(--accent); transform-origin: top; transform: scaleY(var(--p, 0)); }
        .rail-thumb { position: absolute; left: -2px; top: 0; width: 5px; height: 34px; border-radius: 3px; background: var(--ink); cursor: grab; z-index: 4; transform: translateY(calc(var(--p, 0) * (var(--h, 0px) - 34px))); transition: background 0.2s; }
        .rail.dragging .rail-thumb { cursor: grabbing; background: var(--accent); }
        .rail-hit { position: absolute; top: -8px; bottom: -8px; left: -14px; right: -6px; cursor: pointer; z-index: 1; }
        .rail-marks { list-style: none; position: absolute; inset: 0; pointer-events: none; z-index: 3; }
        .rail-marks li { position: absolute; left: 0; right: 0; top: calc(var(--m, 0) * 100%); height: 0; }
        .rail-marks a { pointer-events: auto; position: absolute; right: 0; top: -12px; height: 24px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; white-space: nowrap; }
        .rail-marks a::after { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--ink-3); transform: translateX(-0.5px); transition: border-color 0.2s, background 0.2s, transform 0.2s var(--ease-out); }
        .rail-marks a span { font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); opacity: 0; transform: translateX(6px); transition: opacity 0.18s ease-out, transform 0.22s var(--ease-out); }
        .rail:hover .rail-marks a span, .rail.dragging .rail-marks a span, .rail-marks a.active span { opacity: 1; transform: none; }
        .rail-marks a.active span { color: var(--ink); }
        .rail-marks a.active::after, .rail-marks a:hover::after { border-color: var(--accent); background: var(--accent); transform: translateX(-0.5px) scale(1.15); }
        .rail-marks a.passed::after { border-color: var(--accent); }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .masthead .id-photo, .masthead-text > *, .id > *, .rail { animation: none; opacity: 1; transform: none; filter: none; }
        .section, .section [data-stagger] > * { opacity: 1; transform: none; transition: none; }
        .timeline::after { transform: none; }
        .cta::before { display: none; }
        .rail-marks a span { transition: none; }
      }

      /* ── Responsive ─────────────────────────────── */
      @media (max-width: 960px) {
        .page { grid-template-columns: 1fr; grid-template-areas: 'head' 'id' 'content'; gap: 0; padding: 0 28px; }
        .masthead { flex-direction: column; align-items: flex-start; gap: 18px; padding: 40px 0 0; }
        .id-photo { width: 88px; height: 88px; }
        .masthead .id-name { font-size: 40px; }
        .masthead .id-title { font-size: 17px; }
        .id { position: static; height: auto; padding: 20px 0 8px; overflow: visible; }
        .id-nav { display: none; }
        .id-foot { margin-top: 28px; padding-top: 0; }
        .content { padding: 40px 0 72px; }
        .section { padding-bottom: 64px; }
      }
      @media (max-width: 600px) {
        body { font-size: 15px; }
        .page { padding: 0 20px; }
        .masthead .id-name { font-size: 34px; }
        .entry, .skill-row, .edu { grid-template-columns: 1fr; gap: 6px; }
        .entry { padding: 18px 14px; margin: 0 -14px; }
        .timeline::before, .timeline::after, .timeline .entry::after { display: none; }
        .certs { grid-template-columns: 1fr; }
        .about .facts { gap: 24px; flex-wrap: wrap; }
        .services, .engage, .industries { grid-template-columns: 1fr; }
        .recent li { grid-template-columns: 1fr; gap: 8px; }
        .recent .result { text-align: left; }
        .cta { padding: 28px 22px; }
        .cta h3 { font-size: 26px; }
      }
      @media (max-width: 960px) {
        .process { grid-template-columns: 1fr 1fr; }
      }

      /* ── Print / PDF: the web layout translated to A4 ── */
      .print-doc { display: none; }
      @media print {
        @page { size: A4; margin: 10mm 13mm 10mm; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        html { font-size: 9.25pt; }
        body { background: #fff; color: #333; font-family: var(--body); line-height: 1.34; padding: 0; min-height: 0; }
        .page, .rail, .download-btn { display: none !important; }
        .print-doc { display: block; }

        .pd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16pt; padding-bottom: 11pt; border-bottom: 1.2pt solid #14171C; }
        .pd-id { display: flex; align-items: center; gap: 14pt; }
        .pd-photo { width: 50pt; height: 50pt; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 1pt #D7DBE0; }
        .pd-industries { display: grid; grid-template-columns: 1fr 1fr; gap: 3pt 18pt; margin-top: 8pt; padding-top: 7pt; border-top: 0.5pt solid #EEF0F2; }
        .pd-industries div { font-size: 8.4pt; line-height: 1.38; color: #464C56; }
        .pd-industries b { color: #14171C; font-weight: 700; }
        .pd-clients { margin-top: 7pt; font-size: 8.2pt; line-height: 1.5; color: #464C56; }
        .pd-clients b { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; font-size: 7.4pt; color: #7A828E; margin-right: 6pt; }
        .pd-clients span + span::before { content: '  ·  '; color: #B8C7DA; }
        .pd-name { font-family: var(--display); font-variation-settings: 'opsz' 48, 'wdth' 94; font-weight: 700; font-size: 23pt; letter-spacing: -0.025em; color: #14171C; line-height: 1; }
        .pd-role { font-size: 10.5pt; font-weight: 600; color: #14171C; margin-top: 4pt; white-space: nowrap; }
        .pd-status { display: inline-flex; align-items: center; gap: 5pt; margin-top: 4pt; font-size: 8.25pt; color: #464C56; white-space: nowrap; }
        .pd-status::before { content: ''; width: 5pt; height: 5pt; border-radius: 50%; background: #1F8A4C; }
        .pd-contact { text-align: right; font-size: 8.3pt; line-height: 1.6; color: #464C56; white-space: nowrap; padding-top: 2pt; flex: none; }
        .pd-contact .sep { color: #B8C7DA; margin: 0 4pt; }
        .pd-contact a { color: #14171C; }
        .pd-contact .muted { color: #7A828E; }

        .pd-section { margin-top: 8pt; break-inside: auto; }
        .pd-h { font-size: 8pt; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #14171C;
                padding-bottom: 4pt; border-bottom: 0.6pt solid #D7DBE0; margin-bottom: 9pt; break-after: avoid; }
        .pd-profile { font-size: 9.6pt; line-height: 1.5; color: #333; }
        .pd-facts { display: flex; gap: 22pt; margin-top: 9pt; }
        .pd-facts div { font-size: 8.25pt; color: #7A828E; }
        .pd-facts b { font-family: var(--display); font-size: 12.5pt; font-weight: 700; color: #14171C; letter-spacing: -0.02em; margin-right: 4pt; font-variant-numeric: tabular-nums; }

        /* Entry: date column | content, with the timeline rail in the gutter */
        .pd-entry { display: block; position: relative; padding: 4.5pt 0 5pt; break-inside: auto; }
        .pd-entry + .pd-entry { border-top: 0.5pt solid #EEF0F2; }
        .pd-when { position: absolute; left: 0; top: 3.5pt; width: 78pt; font-size: 7.75pt; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7A828E; padding-top: 1.5pt; font-variant-numeric: tabular-nums; }
        .pd-when small { display: block; margin-top: 1.5pt; font-size: 7.5pt; font-weight: 400; letter-spacing: 0; text-transform: none; }
        .pd-body { position: relative; margin-left: 92pt; padding-left: 10pt; border-left: 0.6pt solid #D7DBE0; }
        .pd-body::before { content: ''; position: absolute; left: -3.3pt; top: 3pt; width: 6pt; height: 6pt; border-radius: 50%; background: #fff; border: 1.2pt solid #7A828E; }
        .pd-entry.now .pd-body::before { background: #1F8A4C; border-color: #1F8A4C; }
        .pd-title { font-size: 10pt; font-weight: 700; color: #14171C; line-height: 1.3; }
        .pd-sub { font-size: 8.75pt; color: #464C56; margin-top: 0.5pt; break-after: avoid; }
        .pd-sub .loc { color: #7A828E; }
        .pd-body ul { list-style: none; margin-top: 4pt; }
        .pd-body li { break-inside: avoid; position: relative; padding-left: 9pt; font-size: 8.7pt; line-height: 1.33; margin-bottom: 1pt; color: #333; }
        .pd-body li::before { content: ''; position: absolute; left: 0; top: 0.68em; width: 5pt; height: 0.9pt; background: #7A828E; }
        .pd-body p { font-size: 8.9pt; line-height: 1.36; margin-top: 2pt; color: #333; }
        .pd-tags { margin-top: 2.5pt; font-size: 7.75pt; font-weight: 600; color: #0B5CAD; }
        .pd-tags span + span::before { content: '  ·  '; color: #B8C7DA; font-weight: 400; }
        .pd-projs { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20pt; row-gap: 4pt; }
        .pd-proj { break-inside: avoid; display: block; padding: 0; border-top: 0 !important; }
        .pd-proj:last-child:nth-child(odd) { grid-column: 1 / -1; }
        .pd-proj .pd-when { position: static; width: auto; margin-bottom: 1pt; }
        .pd-proj .pd-when small { display: inline; margin-left: 4pt; }
        .pd-proj .pd-body { margin-left: 0; padding-left: 0; border-left: 0; }
        .pd-proj .pd-body::before { display: none; }
        .pd-proj .pd-title { font-size: 9.8pt; }
        .pd-proj .pd-body p { font-size: 8.4pt; line-height: 1.33; margin-top: 1.5pt; }
        .pd-proj .pd-tags { margin-top: 2.5pt; font-size: 7.6pt; }

        .pd-two { display: grid; grid-template-columns: 1.25fr 1fr 1fr; column-gap: 18pt; break-inside: avoid; }
        .pd-two .pd-skill { grid-template-columns: 1fr; row-gap: 1pt; }
        .pd-inline { font-size: 8.6pt; color: #14171C; line-height: 1.45; }
        .pd-inline.other { color: #464C56; }
        .pd-inline span + span::before { content: '  ·  '; color: #B8C7DA; }
        .pd-skill { display: grid; grid-template-columns: 62pt 1fr; column-gap: 10pt; padding: 3pt 0; border-bottom: 0.5pt solid #EEF0F2; font-size: 8.75pt; color: #333; line-height: 1.4; }
        .pd-skill:last-child { border-bottom: 0; }
        .pd-skill b { font-size: 7.75pt; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7A828E; padding-top: 1pt; }
        .pd-group { margin-top: 4pt; font-size: 7.5pt; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7A828E; }
        .pd-list { list-style: none; }
        .pd-list li { display: flex; align-items: baseline; gap: 5pt; font-size: 8.75pt; color: #14171C; padding: 1.6pt 0; }
        .pd-list li::before { content: ''; width: 4pt; height: 4pt; border-radius: 50%; background: #0B5CAD; flex: none; position: relative; top: -1pt; }
        .pd-list li.other { color: #464C56; }
        .pd-list li.other::before { background: #B8C7DA; }
        .pd-edu { display: grid; grid-template-columns: 30pt 1fr; column-gap: 6pt; padding: 2pt 0; font-size: 8.5pt; }
        .pd-edu span { font-size: 7.75pt; font-weight: 600; letter-spacing: 0.06em; color: #7A828E; padding-top: 1pt; font-variant-numeric: tabular-nums; }
        .pd-edu b { display: block; font-weight: 700; color: #14171C; }
        .pd-edu em { font-style: normal; color: #464C56; }
        .pd-foot { margin-top: 4pt; padding-top: 4pt; border-top: 0.5pt solid #EEF0F2; font-size: 7.6pt; color: #7A828E; line-height: 1.45; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <div class="id-photo"><img src={portraitUrl} alt={`Portrait of ${person.name}`} width="560" height="560" loading="eager" fetchpriority="high" /></div>
        <div class="masthead-text">
          <h1 class="id-name">{person.name}</h1>
          <p class="id-title">{person.title}</p>
          <p class="id-status">Available for new engagements · remote, IST</p>
        </div>
      </header>
      <aside class="id">
        <p class="id-pitch">{person.pitch} <a href="#contact">Tell me about your project →</a></p>

        <nav aria-label="Sections">
          <ul class="id-nav">
            {NAV.map(n => <li><a href={`#${n.id}`} data-nav={n.id}>{n.label}</a></li>)}
          </ul>
        </nav>

        <div class="id-foot">
          <ul class="id-contact">
            <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
            <li><a href={`tel:${person.phone.replace(/\s+/g, '')}`}>{person.phone}</a></li>
            <li><a href={person.linkedinUrl} target="_blank" rel="noopener">{person.linkedin}</a></li>
            <li><a href={person.githubUrl} target="_blank" rel="noopener">{person.github}</a></li>
            <li><a href={person.companyUrl} target="_blank" rel="noopener">cloudalgo.com</a></li>
            <li class="muted">{person.location}</li>
          </ul>
          <a class="download-btn" href="./resume.pdf" download="Sandeep_Kumar_CV.pdf">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v3h16v-3"/></svg>
            Download PDF résumé
          </a>
        </div>
      </aside>

      <main class="content">
        <section id="about" class="section about">
          <h2 class="section-h">About</h2>
          <p>{person.summary}</p>
          <div class="facts">
            <div class="fact"><b data-count={years} data-suffix="+">{years}+</b><span>years in software</span></div>
            <div class="fact"><b data-count="70" data-suffix="+">70+</b><span>projects delivered</span></div>
            <div class="fact"><b data-count={sfCerts.length}>{sfCerts.length}</b><span>Salesforce certifications</span></div>
          </div>
          <div class="industries" data-stagger>
            <span class="industries-h">Industries I know well</span>
            {INDUSTRIES.map(i => <div><b>{i.name}</b><p>{i.text}</p></div>)}
          </div>
          <div class="clients">
            <b>Organisations I have built for</b>
            <ul>{CLIENTS.map(c => <li>{c}</li>)}</ul>
          </div>
        </section>

        <section id="services" class="section">
          <h2 class="section-h">What I do</h2>
          <div class="services" data-stagger>
            {SERVICES.map(sv => (
              <article class="service">
                <h3>{sv.title}</h3>
                <p class="problem">{sv.problem}</p>
                <p class="outcome">{sv.outcome}</p>
              </article>
            ))}
          </div>
          <div class="recent-h">
            <b>Recent work at CloudAlgo</b>
            <a href={person.companyCaseStudiesUrl} target="_blank" rel="noopener">Read the case studies →</a>
          </div>
          <ul class="recent">
            {RECENT_WORK.map(r => (
              <li>
                <div>
                  <div class="who">{r.client}</div>
                  <p class="what">{r.what}</p>
                  <div class="stack">{r.stack}</div>
                </div>
                <div class="result">{r.result}<small>Outcome</small></div>
              </li>
            ))}
          </ul>
          <p class="process-h">How an engagement runs</p>
          <ol class="process" data-stagger>
            {PROCESS.map(st => <li><b>{st.step}</b><p>{st.text}</p></li>)}
          </ol>
        </section>

        <section id="experience" class="section">
          <h2 class="section-h">Experience</h2>
          <div class="timeline">
            {experience.map(job => (
              <article class="entry">
                <div class="entry-when">{yearsOf(job.data)}<small>{job.data.startDate} – {job.data.endDate}</small></div>
                <div>
                  <h3 class="entry-title">{job.data.title}</h3>
                  <p class="entry-sub">{job.data.company}{job.data.location && <span class="loc"> · {job.data.location}</span>}</p>
                  <ul>{parseBullets(job.body).map(b => <li>{b}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="projects" class="section">
          <h2 class="section-h">Selected projects</h2>
          {projects.map(p => (
            <article class="entry">
              <div class="entry-when">{clientOf(p.data.client)[0]}{clientOf(p.data.client)[1] && <small>via {clientOf(p.data.client)[1]}</small>}</div>
              <div>
                <h3 class="entry-title">{p.data.name}</h3>
                <p>{p.body.trim()}</p>
                <div class="tags">{p.data.tech.map((t: string) => <span>{t}</span>)}</div>
              </div>
            </article>
          ))}
        </section>

        <section id="skills" class="section">
          <h2 class="section-h">Technical skills</h2>
          {skills.map(g => (
            <div class="skill-row">
              <b>{g.label}</b>
              <div class="tags">{g.items.map(i => <span>{i}</span>)}</div>
            </div>
          ))}
        </section>

        <section id="certifications" class="section">
          <h2 class="section-h">Certifications</h2>
          <p class="cert-group">Salesforce Certified</p>
          <div class="certs">
            {sfCerts.map(c => (
              <div class="cert"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12z"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/></svg>{c.replace('Salesforce Certified ', '')}</div>
            ))}
          </div>
          <p class="cert-group">Other</p>
          <div class="certs">
            {otherCerts.map(c => (
              <div class="cert other"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12z"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/></svg>{c}</div>
            ))}
          </div>
        </section>

        <section id="education" class="section">
          <h2 class="section-h">Education</h2>
          {education.map(e => (
            <div class="edu"><span>{e.year}</span><div><b>{e.degree}</b><em>{e.institution}</em></div></div>
          ))}
          <p class="interests">{hobbies}</p>
        </section>

        <section id="contact" class="section">
          <h2 class="section-h">Work with me</h2>
          <div class="cta">
            <h3>Have a Salesforce or Heroku problem that needs an architect?</h3>
            <p>Send a few lines about what you are building and what is in the way. I reply within one working day with either a time for a call or a pointer to someone better placed. The engagement runs through CloudAlgo; the architecture and code run through me.</p>
            <div class="cta-actions">
              <a class="cta-primary" href={contactHref}>Email me about your project</a>
              <a class="cta-secondary" href={person.companyCaseStudiesUrl} target="_blank" rel="noopener">CloudAlgo case studies</a>
              <a class="cta-secondary" href={person.linkedinUrl} target="_blank" rel="noopener">Connect on LinkedIn</a>
            </div>
            <div class="engage">
              {ENGAGEMENT.map(e => <div><b>{e.label}</b><p>{e.text}</p></div>)}
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="print-doc" aria-hidden="true">
      <header class="pd-head">
        <div class="pd-id">
          <img class="pd-photo" src={portraitUrl} alt="" />
          <div>
          <div class="pd-name">{person.name}</div>
          <div class="pd-role">{person.title}</div>
          <div class="pd-status">Available for new engagements via CloudAlgo · remote, IST (UTC+5:30)</div>
          </div>
        </div>
        <div class="pd-contact">
          <a href={`mailto:${person.email}`}>{person.email}</a><span class="sep">·</span>{person.phone}<br />
          <a href={person.linkedinUrl}>{person.linkedin}</a><span class="sep">·</span><a href={person.githubUrl}>{person.github}</a><br />
          <a href={person.companyUrl}>cloudalgo.com</a><span class="sep">·</span><span class="muted">{person.location}</span>
        </div>
      </header>

      <section class="pd-section">
        <div class="pd-h">About</div>
        <p class="pd-profile">{person.summary}</p>
        <div class="pd-facts">
          <div><b>{years}+</b>years in software</div>
          <div><b>70+</b>projects delivered</div>
          <div><b>{sfCerts.length}</b>Salesforce certifications</div>
        </div>
        <div class="pd-industries">
          {INDUSTRIES.map(i => <div><b>{i.name}.</b> {i.text}</div>)}
        </div>
        <p class="pd-clients"><b>Clients include</b>{CLIENTS.map(c => <span>{c}</span>)}</p>
      </section>

      <section class="pd-section">
        <div class="pd-h">Experience</div>
        {experience.map(job => (
          <div class={`pd-entry${job.data.endDate === 'Present' ? ' now' : ''}`}>
            <div class="pd-when">{yearsOf(job.data)}<small>{job.data.startDate} – {job.data.endDate}</small></div>
            <div class="pd-body">
              <div class="pd-title">{job.data.title}</div>
              <div class="pd-sub">{job.data.company}{job.data.location && <span class="loc"> · {job.data.location}</span>}</div>
              <ul>{parseBullets(job.body).map(b => <li>{b}</li>)}</ul>
            </div>
          </div>
        ))}
      </section>

      <section class="pd-section">
        <div class="pd-h">Selected projects</div>
        <div class="pd-projs">
        {featuredProjects.map(p => (
          <div class="pd-entry pd-proj">
            <div class="pd-when">{clientOf(p.data.client)[0]}{clientOf(p.data.client)[1] && <small>via {clientOf(p.data.client)[1]}</small>}</div>
            <div class="pd-body">
              <div class="pd-title">{p.data.name}</div>
              <p>{p.body.trim()}</p>
              <div class="pd-tags">{p.data.tech.map((t: string) => <span>{t}</span>)}</div>
            </div>
          </div>
        ))}
        </div>
      </section>

      <div class="pd-two pd-section">
        <section>
          <div class="pd-h">Technical skills</div>
          {skills.map(g => <div class="pd-skill"><b>{g.label}</b><div>{g.items.join(', ')}</div></div>)}
        </section>
        <section>
          <div class="pd-h">Certifications</div>
          <div class="pd-group">Salesforce Certified</div>
          <p class="pd-inline">{sfCerts.map(c => <span>{c.replace('Salesforce Certified ', '')}</span>)}</p>
          <div class="pd-group">Other</div>
          <p class="pd-inline other">{otherCerts.map(c => <span>{c}</span>)}</p>
        </section>
        <section>
          <div class="pd-h">Education</div>
          {education.map(e => <div class="pd-edu"><span>{e.year}</span><div><b>{e.degree}</b><em>{e.institution}</em></div></div>)}
          <p class="pd-foot">{hobbies}</p>
        </section>
      </div>
    </div>

    <nav class="rail" aria-label="Scroll position">
      <div class="rail-hit"></div>
      <div class="rail-track"><div class="rail-fill"></div><div class="rail-thumb" role="scrollbar" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="-1"></div></div>
      <ol class="rail-marks">
        {NAV.map(n => <li data-mark={n.id}><a href={`#${n.id}`} data-nav={n.id}><span>{n.label}</span></a></li>)}
      </ol>
    </nav>

    <script>
      const sections = [...document.querySelectorAll('.section')]
      const links = [...document.querySelectorAll('[data-nav]')]
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

      document.querySelectorAll('[data-stagger]').forEach(g => [...g.children].forEach((c, i) => c.style.setProperty('--i', String(i))))

      const reveal = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target) } })
      }, { threshold: 0.08 })
      sections.forEach(s => reveal.observe(s))

      const spy = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return
          links.forEach(l => l.classList.toggle('active', l.dataset.nav === e.target.id))
        })
      }, { rootMargin: '-30% 0px -60% 0px' })
      sections.forEach(s => spy.observe(s))

      // Stats count up once the About section is in view
      const counters = [...document.querySelectorAll('[data-count]')]
      const countUp = el => {
        const end = Number(el.dataset.count), suffix = el.dataset.suffix || '', t0 = performance.now()
        const tick = now => {
          const k = Math.min(1, (now - t0) / 900), e = 1 - Math.pow(1 - k, 3)
          el.textContent = Math.round(end * e) + suffix
          if (k < 1) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }
      if (!reduced && counters.length) {
        const once = new IntersectionObserver(entries => {
          entries.forEach(e => { if (e.isIntersecting) { countUp(e.target); once.unobserve(e.target) } })
        }, { threshold: 0.6 })
        counters.forEach(c => once.observe(c))
      }

      // Cursor spotlight on the CTA card
      const cta = document.querySelector('.cta')
      cta?.addEventListener('pointermove', e => {
        const r = cta.getBoundingClientRect()
        cta.style.setProperty('--mx', `${e.clientX - r.left}px`)
        cta.style.setProperty('--my', `${e.clientY - r.top}px`)
      })

      // Timeline draw + scroll rail
      const timeline = document.querySelector('.timeline')
      const entries = timeline ? [...timeline.querySelectorAll('.entry')] : []
      const rail = document.querySelector('.rail')
      const thumb = rail?.querySelector('.rail-thumb')
      const marks = rail ? [...rail.querySelectorAll('[data-mark]')] : []
      const clamp = (v, a, b) => Math.min(b, Math.max(a, v))
      const maxScroll = () => document.documentElement.scrollHeight - innerHeight

      const layoutRail = () => {
        if (!rail) return
        const max = maxScroll()
        rail.style.setProperty('--h', `${rail.clientHeight}px`)
        marks.forEach(m => {
          const sec = document.getElementById(m.dataset.mark)
          if (sec) m.style.setProperty('--m', String(clamp((sec.getBoundingClientRect().top + scrollY) / max, 0, 1)))
        })
      }

      let ticking = false
      const paint = () => {
        ticking = false
        const p = clamp(scrollY / Math.max(1, maxScroll()), 0, 1)
        if (rail) {
          rail.style.setProperty('--p', String(p))
          thumb?.setAttribute('aria-valuenow', String(Math.round(p * 100)))
          marks.forEach(m => m.firstElementChild.classList.toggle('passed', Number(m.style.getPropertyValue('--m')) <= p))
        }
        if (timeline && !reduced) {
          const r = timeline.getBoundingClientRect(), line = innerHeight * 0.62
          timeline.style.setProperty('--tl', String(clamp((line - r.top - 30) / (r.height - 60), 0, 1)))
          entries.forEach(el => el.classList.toggle('lit', el.getBoundingClientRect().top + 33 < line))
        }
      }
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(paint) } }
      addEventListener('scroll', onScroll, { passive: true })
      addEventListener('resize', () => { layoutRail(); onScroll() })
      addEventListener('load', () => { layoutRail(); paint() })
      layoutRail(); paint()

      // Drag the thumb, or click anywhere on the rail, to scroll
      if (rail && thumb) {
        const track = rail.querySelector('.rail-track')
        const scrollToY = clientY => {
          const r = track.getBoundingClientRect()
          const p = clamp((clientY - r.top - 17) / (r.height - 34), 0, 1)
          scrollTo({ top: p * maxScroll(), behavior: 'instant' })
        }
        let grab = 0, dragging = false
        thumb.addEventListener('pointerdown', e => {
          e.preventDefault()
          grab = e.clientY - (thumb.getBoundingClientRect().top + thumb.offsetHeight / 2)
          dragging = true
          rail.classList.add('dragging')
          document.body.style.userSelect = 'none'
        })
        document.addEventListener('pointermove', e => { if (dragging) scrollToY(e.clientY - grab) })
        const release = () => { if (!dragging) return; dragging = false; rail.classList.remove('dragging'); document.body.style.userSelect = '' }
        document.addEventListener('pointerup', release)
        document.addEventListener('pointercancel', release)
        rail.querySelector('.rail-hit').addEventListener('click', e => scrollToY(e.clientY))
      }
    </script>
  </body>
</html>
