---
interface Props {
  person: any
  experience: Array<{ data: any; body: string }>
  projects: Array<{ data: any; body: string }>
  skills: Array<{ label: string; items: string[] }>
  education: Array<any>
  certifications: string[]
  hobbies: string
}
const { person, experience, projects, skills, education, certifications, hobbies } = Astro.props

function parseBullets(body: string): string[] {
  return body.split('\n').map(l => l.replace(/^-\s+/, '').trim()).filter(Boolean)
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{person.name} — Resume</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --black: #0a0a0a;
        --white: #ffffff;
        --yellow: #f5f500;
        --yellow-dark: #c8c800;
        --grey: #1a1a1a;
        --mid: #555;
        --border: 2px solid var(--black);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { font-size: 16px; }

      body {
        background: var(--white);
        color: var(--black);
        font-family: 'Space Mono', monospace;
        min-height: 100vh;
      }

      /* ── Download button ─────────────────────────── */
      .download-btn {
        position: fixed;
        bottom: 0;
        right: 0;
        background: var(--yellow);
        color: var(--black);
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        padding: 14px 24px;
        z-index: 100;
        border-left: var(--border);
        border-top: var(--border);
        transition: background 0.15s;
      }
      .download-btn:hover { background: var(--yellow-dark); }

      /* ── Header ──────────────────────────────────── */
      .header {
        background: var(--black);
        padding: 0;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: stretch;
        border-bottom: var(--border);
      }

      .header-num {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 120px;
        color: var(--yellow);
        line-height: 1;
        padding: 20px 28px 16px;
        border-right: var(--border);
        display: flex;
        align-items: center;
        min-width: 160px;
      }

      .header-center {
        padding: 28px 32px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .header-name {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(32px, 5vw, 56px);
        color: var(--white);
        letter-spacing: 3px;
        line-height: 1;
        margin-bottom: 8px;
      }

      .header-role {
        font-size: 12px;
        color: var(--yellow);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        font-weight: 700;
      }

      .header-contact {
        padding: 20px 28px;
        border-left: var(--border);
        font-size: 13px;
        color: #aaa;
        line-height: 2.2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        letter-spacing: 0.3px;
      }
      .header-contact a { color: var(--yellow); text-decoration: none; }
      .header-contact a:hover { text-decoration: underline; }

      /* ── Grid row layout ─────────────────────────── */
      .row {
        display: grid;
        grid-template-columns: 48px 1fr;
        border-bottom: var(--border);
      }
      .row:last-child { border-bottom: none; }

      .row-tag {
        background: var(--black);
        color: var(--yellow);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        display: flex;
        align-items: center;
        justify-content: center;
        border-right: var(--border);
        padding: 12px 0;
        text-transform: uppercase;
      }

      .row-content {
        padding: 0;
      }

      /* ── Section header within row ───────────────── */
      .section-heading {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 28px;
        letter-spacing: 3px;
        color: var(--black);
        padding: 16px 24px 0;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 12px;
        margin-bottom: 0;
      }

      /* ── Experience entries ───────────────────────── */
      .experience-entry {
        padding: 24px 24px;
        border-bottom: 1px solid #e0e0e0;
      }
      .experience-entry:last-child { border-bottom: none; }

      .entry-header {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: baseline;
        margin-bottom: 4px;
      }

      .entry-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 22px;
        letter-spacing: 2px;
        color: var(--black);
        line-height: 1;
      }

      .entry-dates {
        font-size: 12px;
        color: var(--mid);
        letter-spacing: 1px;
        white-space: nowrap;
      }

      .entry-company {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--yellow-dark);
        text-transform: uppercase;
        margin-bottom: 10px;
      }

      .entry-bullets {
        list-style: none;
      }
      .entry-bullets li {
        font-size: 14px;
        color: #333;
        line-height: 1.8;
        margin-bottom: 7px;
        padding-left: 20px;
        position: relative;
      }
      .entry-bullets li::before {
        content: '//';
        position: absolute;
        left: 0;
        color: var(--yellow-dark);
        font-weight: 700;
        font-size: 11px;
      }

      /* ── Projects ────────────────────────────────── */
      .projects-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
      }
      .project-entry {
        padding: 22px 24px;
        border-bottom: 1px solid #e0e0e0;
        border-right: 1px solid #e0e0e0;
      }
      .project-entry:nth-child(even) { border-right: none; }
      .project-entry:last-child,
      .project-entry:nth-last-child(2):nth-child(odd) { border-bottom: none; }

      .project-name {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 18px;
        letter-spacing: 2px;
        color: var(--black);
        line-height: 1;
        margin-bottom: 4px;
      }
      .project-client {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--yellow-dark);
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .project-body {
        font-size: 13px;
        color: #444;
        line-height: 1.78;
        margin-bottom: 12px;
        font-style: italic;
      }
      .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
      }
      .tech-tag {
        font-size: 10px;
        letter-spacing: 0.5px;
        color: var(--black);
        background: var(--yellow);
        padding: 3px 8px;
        font-weight: 700;
      }

      /* ── Skills ──────────────────────────────────── */
      .skills-row {
        padding: 22px 24px;
      }
      .skill-group {
        margin-bottom: 16px;
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 12px;
        align-items: baseline;
      }
      .skill-group:last-child { margin-bottom: 0; }
      .skill-group-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--yellow-dark);
      }
      .skill-items {
        font-size: 14px;
        color: #333;
        line-height: 1.75;
      }

      /* ── Education ───────────────────────────────── */
      .education-entry {
        padding: 18px 24px;
        border-bottom: 1px solid #e0e0e0;
      }
      .education-entry:last-child { border-bottom: none; }
      .edu-degree {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 20px;
        letter-spacing: 2px;
        color: var(--black);
        line-height: 1;
      }
      .edu-institution {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--yellow-dark);
        text-transform: uppercase;
        margin-top: 4px;
      }

      /* ── Scroll reveal ───────────────────────────── */
      [data-reveal] {
        opacity: 0;
        transform: translateX(-12px);
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      [data-reveal].visible {
        opacity: 1;
        transform: none;
      }

      /* ── Print ───────────────────────────────────── */
      @media print {
        body { padding: 0 14mm !important; background: var(--white); }
        .download-btn { display: none !important; }
        .experience-entry, .project-entry, .education-entry { break-inside: avoid; }
        .section-heading { break-after: avoid; }
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        @page { size: A4; margin: 10mm 0; }
      }

      @media (max-width: 640px) {
        .header { grid-template-columns: auto 1fr; }
        .header-contact { display: none; }
        .header-num { font-size: 72px; min-width: 100px; padding: 16px; }
        .projects-grid { grid-template-columns: 1fr; }
        .project-entry { border-right: none; }
      }
    </style>
  </head>
  <body>
    <a href="./resume.pdf" class="download-btn no-print" download>↓ PDF</a>

    <!-- Header -->
    <header class="header">
      <div class="header-num">SK</div>
      <div class="header-center">
        <h1 class="header-name">{person.name}</h1>
        <p class="header-role">{person.title}</p>
      </div>
      <div class="header-contact">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        {person.phone}
        {person.location}
        <a href={person.linkedinUrl} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={person.githubUrl} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </header>

    <!-- Experience -->
    <div class="row" data-reveal>
      <div class="row-tag">Exp</div>
      <div class="row-content">
        <h2 class="section-heading">Experience</h2>
        {experience.map(job => (
          <article class="experience-entry">
            <div class="entry-header">
              <span class="entry-title">{job.data.title}</span>
              <span class="entry-dates">{job.data.startDate} – {job.data.endDate}</span>
            </div>
            <div class="entry-company">{job.data.company}{job.data.location ? ` / ${job.data.location}` : ''}</div>
            <ul class="entry-bullets">
              {parseBullets(job.body).map(b => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <!-- Projects -->
    <div class="row" data-reveal>
      <div class="row-tag">Proj</div>
      <div class="row-content">
        <h2 class="section-heading">Projects</h2>
        <div class="projects-grid">
          {projects.map(p => (
            <article class="project-entry">
              <div class="project-name">{p.data.name}</div>
              {p.data.client && <div class="project-client">{p.data.client}</div>}
              <p class="project-body">{p.body.trim()}</p>
              <div class="project-tech">
                {p.data.tech.map((t: string) => <span class="tech-tag">{t}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <!-- Skills -->
    <div class="row" data-reveal>
      <div class="row-tag">Skill</div>
      <div class="row-content">
        <h2 class="section-heading">Skills</h2>
        <div class="skills-row">
          {skills.map(group => (
            <div class="skill-group">
              <span class="skill-group-label">{group.label}</span>
              <span class="skill-items">{group.items.join(' · ')}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Education -->
    <div class="row" data-reveal>
      <div class="row-tag">Edu</div>
      <div class="row-content">
        <h2 class="section-heading">Education</h2>
        {education.map(edu => (
          <div class="education-entry">
            <div class="edu-degree">{edu.degree}</div>
            <div class="edu-institution">{edu.institution}{edu.year ? ` · ${edu.year}` : ''}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications -->
    <div class="row" data-reveal>
      <div class="row-tag">Cert</div>
      <div class="row-content">
        <h2 class="section-heading">Certifications</h2>
        <div class="skills-row" style="display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;">
          {certifications.map(cert => (
            <div style="font-size:13px;color:#222;line-height:1.8;padding-left:20px;position:relative;">
              <span style="position:absolute;left:0;color:#c8c800;font-weight:700;font-size:11px;">//</span>
              {cert}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Hobbies -->
    <div class="row" data-reveal>
      <div class="row-tag">Life</div>
      <div class="row-content">
        <h2 class="section-heading">Interests</h2>
        <div class="skills-row">
          <p style="font-size:14px;color:#333;line-height:1.8;font-style:italic;">{hobbies}</p>
        </div>
      </div>
    </div>

    <script>
      const observer = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target) } }),
        { threshold: 0.08 }
      )
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el))
    </script>
  </body>
</html>
